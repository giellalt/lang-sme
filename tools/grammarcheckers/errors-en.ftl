syn-boasttu-compound = Compound word error
    .desc = You have written "{$1}" as two words. "Boasttu" should be compounded with the following word.
    .example-1 = Mon álo válddan boasttu niibbi!

msyn-demphrase-placc = Wrong case
    .desc = The demonstrative pronoun "{$1}" must be in the same case as the noun "{$2}".
    .example-1 =

syn-double-negation = Incorrect negation
    .desc = Do not inflect both "{$1}" and the following negative verb.
    .example-1 = Čiegain lea botken buot máđiid amaset eat beasa vuojániiguin luomejekkiide.

msyn-ačča-aččat = Wrong form
    .desc = The adjective "{$1}" must take the plural accusative ending "-t".
    .example-1 = Finálačiekčamat šaddege nu miellagiddevačča go loahppačiekčamat galgetge leat.
    .ref-1 = Pope2004:120

msyn-ba-ga = Wrong form
    .desc = The verb form of "{$1}" has the ending "-ga".
    .example-1 = Jođiheaddji guovttosges oaččuiba jo ánsoruossa, mii lea čuovvovaš ánsu maŋŋá gollemedálja.

syn-pers-refl-congruence = Agreement error
    .desc = The reflexive pronoun "{$1}" must agree in person and number.
    .example-1 = Lea sin iežas sivva ahte dorohallet, go bahkkejit sarvá lusa go lea rahkame, dadjá son.

msyn-case-number-congruence-moanat-all = Agreement error
    .desc = Both "moanat" and the following noun "{$1}" must agree in case. "Moanat" also requires a plural noun.
    .example-1 = Moanat buori spábbačiekči leat boahtán Jergolis.

msyn-miehtá-Acc = Wrong case!!
    .desc =
    .example-1 = Mii háliidit ahte Guovdageaidnu ja Sámi allaskuvla dál maid galgá leat sámi nuoraid ja earáid deaivvadanbáiki, ja čohkket ollu sámi studeanttaid miehtá Sámis.

msyn-plcom-plloc = Wrong case
    .desc = "-guin" is the plural comitative ending. The plural locative ending "-in" should be used here.
