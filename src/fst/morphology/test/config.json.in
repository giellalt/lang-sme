{
    "analyser": "@abs_builddir@/../../analyser-gt-norm.hfstol",
    "generator": "@abs_builddir@/../../generator-gt-norm.hfstol",
    "lexcroot": "@abs_srcdir@/../root.lexc",
    "nouns": {
        "lexcfile": "@abs_srcdir@/../stems/nouns.lexc",
        "lemmatags": ["+N+Sg+Nom", "+N+Pl+Nom", "+N+NomAg+Sg+Nom", "+N+NomAg+Pl+Nom", "+N+G3+Sg+Nom", "+N+G7+Sg+Nom"],
        "exclusions": ["(CmpN/Onlu|ShCmp|\\+Cmp/SplitR|\\+V\\+|AGAdj|AHKASAS|NOT-TO-LEMMATEST|ALLGUOVT|\\+Use/MT|RHyph|Cmp/Sh|Rnoun)"]
    },
    "adjectives": {
        "lexcfile": "@abs_srcdir@/../stems/adjectives.lexc",
        "lemmatags": ["+A+Sg+Nom", "+A+Attr", "+A+Pl+Nom"],
        "exclusions": ["(FINJU|\\+Use/MT|Lex|Sub)"]
    },
    "propernouns": {
        "lexcfile": "@abs_srcdir@/../stems/sme-propernouns.lexc",
        "lemmatags": ["+N+Prop+Sg+Nom", "+N+Prop+Pl+Nom", "+N+Prop+Attr"],
        "exclusions": ["(ProperNoun|\\+Use/MT)"]
    },
    "verbs": {
        "lexcfile": "@abs_srcdir@/../stems/verbs.lexc",
        "lemmatags": ["+V+Inf"],
        "exclusions": ["(STRAYFORMS|ENDLEX|\\+Neg|\\+Use/MT)"]
    },
    "otherlexcs": [
        "@abs_srcdir@/../stems/adpositions.lexc",
        "@abs_srcdir@/../stems/adverbs.lexc",
        "@abs_srcdir@/../stems/conjunctions.lexc",
        "@abs_srcdir@/../stems/interjections.lexc",
        "@abs_srcdir@/../stems/numerals.lexc",
        "@abs_srcdir@/../stems/particles.lexc",
        "@abs_srcdir@/../stems/pronouns.lexc",
        "@abs_srcdir@/../stems/subjunctions.lexc",
        "@abs_srcdir@/../affixes/abbreviations.lexc",
        "@abs_srcdir@/../affixes/acronyms.lexc",
        "@abs_srcdir@/../affixes/nouns.lexc",
        "@abs_srcdir@/../affixes/numerals.lexc",
        "@abs_srcdir@/../affixes/possessive-suffixes.lexc",
        "@abs_srcdir@/../affixes/pronouns.lexc",
        "@abs_srcdir@/../affixes/propernouns.lexc",
        "@abs_srcdir@/../affixes/symbols.lexc",
        "@abs_srcdir@/../affixes/verbs.lexc",
        "@abs_srcdir@/../clitics.lexc",
        "@abs_srcdir@/../compounding.lexc",
        "@abs_builddir@/../generated_files/smi-sme-propernouns.lexc",
        "@abs_builddir@/../generated_files/smi-sme-acronyms.lexc",
        "@abs_builddir@/../generated_files/smi-sme-arabic_roman_digits.lexc",
        "@abs_builddir@/../generated_files/smi-sme-digits.lexc",
        "@abs_builddir@/../generated_files/mul-sme-punctuation.lexc",
        "@abs_builddir@/../generated_files/mul-sme-symbols.lexc"
    ]
}
